{
  "name": "vara",
  "version": "0.1.1",
  "description": "VARA — a terminal coding agent that works with any provider, proves its results, and cuts your token bill.",
  "type": "module",
  "bin": {
    "vara": "./dist/cli.js"
  },
  "scripts": {
    "dev": "tsx src/cli.tsx",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "ink": "^5.1.0",
    "react": "^18.3.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "ink-testing-library": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VARA-TEAM/vara-cli.git"
  },
  "bugs": {
    "url": "https://github.com/VARA-TEAM/vara-cli/issues"
  },
  "homepage": "https://github.com/VARA-TEAM/vara-cli#readme",
  "keywords": [
    "cli",
    "agent",
    "llm",
    "mcp",
    "terminal",
    "coding-agent"
  ],
  "license": "MIT"
}
