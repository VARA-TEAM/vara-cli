*.log
tmp-*.mjs
*.tmp

# Test/coverage output
coverage/

# TypeScript incremental cache
*.tsbuildinfo

# Editor & OS noise
.vscode/
.idea/
.DS_Store
Thumbs.db

# Local agent tooling
.claude/
.opencode/

# Conversation exports
vara-*.md
