# Settings for `vara serve`. Copy to /etc/vara/vara.env (systemd) or deploy/.env (docker compose) and edit.
# Every line is optional except the model key. Empty values count as "not set".
# This file holds a secret: keep it readable by the service user only (chmod 640/600) and never commit it.

# --- the model key (use the variable your provider expects) -----------------------------------------------------
OPENAI_API_KEY=
#ANTHROPIC_API_KEY=
#OPENROUTER_API_KEY=

# --- where the host is reachable -------------------------------------------------------------------------------
# The DNS name your reverse proxy serves (no scheme, no port). Needed for browsers to use a domain name.
VARA_PUBLIC_HOST=
# 1 only when a reverse proxy in front sets X-Forwarded-For and is the ONLY way in (bind 127.0.0.1 or a firewall).
VARA_TRUST_PROXY=0

# --- the owner token ---------------------------------------------------------------------------------------------
# Default: VARA makes one on the first start, prints a one-time login link, and stores only its hash.
# Lost it? Start once with `vara serve --rotate-token`.
# Or provide your own (at least 24 characters). A file is safer than a value (a value shows up in process listings):
#VARA_OWNER_TOKEN_FILE=/etc/vara/owner-token
#VARA_OWNER_TOKEN=

# --- rarely changed (the systemd unit / Dockerfile already set sensible values) ------------------------------------
#VARA_PORT=7777
#VARA_BIND=127.0.0.1
#VARA_LOG=journal      # text | json | journal
#VARA_NO_UPDATE_CHECK=1
